      "type": "single-select",
      "question": "What is the derivative of KaT[x^2] with respect to KaT[x]?",
      "options": [
        {
          "value": "A",
          "label": "KaT[x]"
        },
        {
          "value": "B",
          "label": "KaT[2x]"
        },
        {
          "value": "C",
          "label": "KaT[x^3]"
        },
        {
          "value": "D",
          "label": "KaT[2]"
        }
      ],
      "answer": "B",
      "explanation": {
        "text": "Using the power rule KaT[\\frac{d}{dx}x^n = nx^{n-1}], the derivative of KaT[x^2] is KaT[2x].",
        "learnMore": false
      }
    },
    {
