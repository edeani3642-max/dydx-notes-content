      "id": "mechanics-003",
      "type": "single-select",
      "question": "A force of KaT[10\\,N] acts on a mass of KaT[2\\,kg]. What is the acceleration?",
      "options": [
        {
          "value": "A",
          "label": "KaT[2\\,m/s^2]"
        },
        {
          "value": "B",
          "label": "KaT[5\\,m/s^2]"
        },
        {
          "value": "C",
          "label": "KaT[10\\,m/s^2]"
        },
        {
          "value": "D",
          "label": "KaT[20\\,m/s^2]"
        }
      ],
      "answer": "B",
      "explanation": {
        "text": "From Newton's second law, KaT[F = ma]. Therefore KaT[a = F/m = 10/2 = 5\\,m/s^2].",
