      "id": "mechanics-001",
      "type": "single-select",
      "question": "A body starts from rest and accelerates uniformly at KaT[2\\,m/s^2]. What is its velocity after KaT[5\\,s]?",
      "options": [
        {
          "value": "A",
          "label": "KaT[5\\,m/s]"
        },
        {
          "value": "B",
          "label": "KaT[10\\,m/s]"
        },
        {
          "value": "C",
          "label": "KaT[15\\,m/s]"
        },
        {
          "value": "D",
          "label": "KaT[20\\,m/s]"
        }
      ],
      "answer": "B",
      "explanation": {
        "text": "Using KaT[v = u + at], with KaT[u = 0], KaT[a = 2\\,m/s^2], and KaT[t = 5\\,s], we obtain KaT[v = 10\\,m/s].",
        "learnMore": false
      }
    },
