      "title": "Introduction to Newton's Laws",
      "content": "https://www.youtube.com/embed/kKKM8Y-u7ds"
    },
    {
      "type": "heading",
      "size": 2,
      "content": "Newton's Second Law"
    },
    {
      "type": "text",
      "content": "The net force acting on an object is equal to the product of its mass and acceleration."
    },
    {
      "type": "formula",
      "content": "KaT[F = ma]"
    },
    {
      "type": "solution",
      "content": [
        {
          "instruction": "Identify the mass and acceleration.",
          "solution": "KaT[m = 5\\,kg,\\quad a = 2\\,m/s^2]"
        },
        {
          "instruction": "Apply Newton's second law.",
          "solution": "KaT[F = ma = 5 \\times 2 = 10\\,N]"
        },
        {
          "instruction": "State the answer.",
          "solution": "KaT[F = 10\\,N]"
        }
      ]
    }
  ]
