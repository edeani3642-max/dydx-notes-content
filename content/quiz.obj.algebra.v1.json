    {
      "id": "algebra-001",
      "type": "single-select",
      "question": "If KaT[2x + 3 = 11], what is the value of KaT[x]?",
      "options": [
        {
          "value": "A",
          "label": "KaT[2]"
        },
        {
          "value": "B",
          "label": "KaT[3]"
        },
        {
          "value": "C",
          "label": "KaT[4]"
        },
        {
          "value": "D",
          "label": "KaT[7]"
        }
      ],
      "answer": "C",
      "explanation": {
        "text": "Subtract 3 from both sides to obtain KaT[2x = 8]. Dividing by 2 gives KaT[x = 4].",
        "learnMore": false
      }
    },
    {
      "id": "algebra-002",
      "type": "single-select",
      "question": "Simplify KaT[3x + 2x - 4].",
      "options": [
        {
          "value": "A",
          "label": "KaT[5x - 4]"
        },
        {
          "value": "B",
          "label": "KaT[6x - 4]"
        },
        {
          "value": "C",
          "label": "KaT[5x + 4]"
        },
        {
          "value": "D",
          "label": "KaT[x - 4]"
        }
      ],
      "answer": "A",
      "explanation": {
        "text": "Collecting like terms gives KaT[3x + 2x = 5x], so the expression becomes KaT[5x - 4].",
        "learnMore": false
      }
    },
    {
      "id": "algebra-003",
      "type": "single-select",
      "question": "If KaT[x^2 = 25], which value can KaT[x] take?",
      "options": [
        {
          "value": "A",
          "label": "KaT[5] only"
        },
        {
          "value": "B",
          "label": "KaT[-5] only"
        },
        {
          "value": "C",
          "label": "KaT[\\pm 5]"
        },
        {
          "value": "D",
          "label": "KaT[25]"
        }
      ],
      "answer": "C",
      "explanation": {
        "text": "Taking the square root of both sides gives KaT[x = \\pm\\sqrt{25} = \\pm5].",
        "learnMore": false
      }
    }
