    {
      "id": "mechanics-004",
      "type": "single_select",
      "question": "A force of 10 N acts on a mass of 2 kg. What acceleration does the mass acquire?",
      "options": [
        {
          "value": "A",
          "label": "2 m/s²"
        },
        {
          "value": "B",
          "label": "5 m/s²"
        },
        {
          "value": "C",
          "label": "10 m/s²"
        },
        {
          "value": "D",
          "label": "20 m/s²"
        }
      ],
      "correctValues": ["B"],
      "explanation": {
        "text": "From Newton's second law, F = ma. Therefore a = F/m = 10/2 = 5 m/s².",
        "learnMore": false
      }
    },
