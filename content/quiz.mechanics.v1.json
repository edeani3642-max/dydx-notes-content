    {
      "id": "mechanics-001",
      "type": "single_select",
      "question": "A car travels at a constant speed of 20 m/s for 5 seconds. What distance does it cover?",
      "options": [
        {
          "value": "A",
          "label": "25 m"
        },
        {
          "value": "B",
          "label": "50 m"
        },
        {
          "value": "C",
          "label": "100 m"
        },
        {
          "value": "D",
          "label": "200 m"
        }
      ],
      "correctValues": ["C"],
      "explanation": {
        "text": "For constant speed, distance is speed multiplied by time: 20 × 5 = 100 m.",
        "learnMore": false
      }
    },
    {
      "id": "mechanics-002",
      "type": "single_select",
      "question": "A body changes its velocity from 10 m/s to 30 m/s in 5 seconds. What is its acceleration?",
      "options": [
        {
          "value": "A",
          "label": "2 m/s²"
        },
        {
          "value": "B",
          "label": "4 m/s²"
        },
        {
          "value": "C",
          "label": "5 m/s²"
        },
        {
          "value": "D",
          "label": "8 m/s²"
        }
      ],
      "correctValues": ["B"],
      "explanation": {
        "text": "Acceleration is the change in velocity divided by time: (30 − 10) / 5 = 4 m/s².",
        "learnMore": false
      }
    },
    {
      "id": "mechanics-003",
      "type": "single_select",
      "question": "Which of the following is the SI unit of force?",
