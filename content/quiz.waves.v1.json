      "type": "single_select",
      "question": "A wave has a frequency of 5 Hz. How many complete oscillations occur in 4 seconds?",
      "options": [
        {
          "value": "A",
          "label": "1.25"
        },
        {
          "value": "B",
          "label": "9"
        },
        {
          "value": "C",
          "label": "20"
        },
        {
          "value": "D",
          "label": "25"
        }
      ],
      "correctValues": ["C"],
      "explanation": {
        "text": "The number of oscillations is frequency multiplied by time: 5 × 4 = 20.",
        "learnMore": false
      }
    },
    {
      "id": "waves-002",
      "type": "single_select",
      "question": "What is the relationship between frequency f and period T?",
      "options": [
        {
          "value": "A",
          "label": "T = f"
        },
        {
          "value": "B",
          "label": "T = 1/f"
        },
