          "value": "C",
          "label": "T = f²"
        },
        {
          "value": "D",
          "label": "T = 2f"
        }
      ],
      "correctValues": ["B"],
      "explanation": {
        "text": "The period is the reciprocal of frequency: T = 1/f.",
        "learnMore": false
      }
